PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Only needed once when creating the first administrator.
ADMIN_USERNAME=your_admin_username
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use_a_unique_password_at_least_12_characters

# Optional: private bearer token for ChatGPT Actions. Generate a long random secret locally.
CHATGPT_INTEGRATION_TOKEN=replace_with_a_private_random_token_at_least_32_characters
